# 平台智能助手 —— 大模型配置示例
# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 忽略，不会提交）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 助手内部回调本服务接口的基址（自调用，用于工具执行）
ASSISTANT_INTERNAL_BASE=http://127.0.0.1:8000

# 注册/找回密码验证码（Redis 独立使用 db 1）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_VERIFICATION_DB=1
VERIFICATION_CODE_TTL=300
VERIFICATION_TOKEN_TTL=600
VERIFICATION_SEND_COOLDOWN=60
VERIFICATION_HOURLY_LIMIT=5
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_SECRET=请替换为随机长字符串

# 邮箱验证码沿用告警邮件 SMTP 配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=你的QQ邮箱
SMTP_PASSWORD=你的QQ邮箱授权码

# 短信发送器：console 为开发通道；后续可扩展 aliyun/tencent 实现
SMS_PROVIDER=console
