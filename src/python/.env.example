# 平台智能助手 —— 大模型配置示例
# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 忽略，不会提交）
DEEPSEEK_API_KEY=sk-你的 DeepSeek 密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 助手内部回调本服务接口的基址（自调用，用于工具执行）
ASSISTANT_INTERNAL_BASE=http://127.0.0.1:8000
# 微信公众号 / 测试号配置（客服消息异步推送，填入测试号后台的 appID 和 appsecret）
WECHAT_APPID=你的测试号 appID
WECHAT_APPSECRET=你的测试号 appsecret
# 平台前端地址（生成模块跳转链接用）
PLATFORM_URL=http://你的平台域名或 IP:端口
